FROM artifacts.developer.gov.bc.ca/docker-remote/node:24.21.0 as builder
ENV NODE_ENV=production
WORKDIR /usr/src/app
COPY ./ ./
RUN npm install --omit=dev && \ 
    npm run build

FROM artifacts.developer.gov.bc.ca/docker-remote/nginxinc/nginx-unprivileged:1.30.1-alpine
COPY --from=builder /usr/src/app/dist /app
COPY ./nginx.conf /etc/nginx/nginx.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
