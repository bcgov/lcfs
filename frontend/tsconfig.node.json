    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "types": ["node"],
    "strict": true,
    "tsBuildInfoFile": "./node_modules/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "cypress.config.ts"]
}
