# Optional for the unauthenticated pilot tests.
# Set only when targeting an already-running app; otherwise Playwright starts Vite.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_WORKERS=

# Needed only for authenticated scenarios.
PLAYWRIGHT_ADMIN_IDIR_EMAIL=
PLAYWRIGHT_ADMIN_IDIR_USERNAME=
PLAYWRIGHT_ADMIN_IDIR_PASSWORD=
PLAYWRIGHT_BCEID_TEST_USER=
PLAYWRIGHT_BCEID_TEST_PASS=
PLAYWRIGHT_IDIR_TEST_USER=
PLAYWRIGHT_IDIR_TEST_PASS=
PLAYWRIGHT_ORG1_BCEID_USERNAME=
PLAYWRIGHT_ORG1_BCEID_PASSWORD=
PLAYWRIGHT_ORG2_BCEID_USERNAME=
PLAYWRIGHT_ORG2_BCEID_PASSWORD=
PLAYWRIGHT_TEST_SUPPLIER_USERNAME=
PLAYWRIGHT_TEST_SUPPLIER_PASSWORD=

# Needed only by scenarios that explicitly call tasks.clearComplianceReports().
PLAYWRIGHT_DB_USER=lcfs
PLAYWRIGHT_DB_HOST=localhost
PLAYWRIGHT_DB_NAME=lcfs
PLAYWRIGHT_DB_PASSWORD=development_only
PLAYWRIGHT_DB_PORT=5432
