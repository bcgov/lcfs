    "@mui/x-tree-view": "^7.29.10",
    "@react-keycloak/web": "^3.4.0",
    "@tanstack/react-query": "^5.69.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ag-grid-community": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "autosuggest-highlight": "^3.3.4",
    "axios": "^1.20.0",
    "buffer": "^6.0.3",
    "chroma-js": "^3.1.2",
    "country-list": "^2.3.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.7",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "esbuild": "^0.28.1",
    "html2canvas": "^1.4.1",
    "i18next": "^24.2.3",
    "jspdf": "^4.2.1",
    "keycloak-js": "^26.1.4",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "mammoth": "^1.12.3",
