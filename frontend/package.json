    },
    "@cypress/request": {
      "qs": "^6.17.0",
      "uuid": "^11.1.1"
    },
    "mocha": {
      "serialize-javascript": "^7.1.4"
    },
    "@badeball/cypress-cucumber-preprocessor": {
      "uuid": "^11.1.1"
    },
    "@cucumber/cucumber": {
