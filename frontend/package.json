{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "preview": "vite preview",
    "test": "vitest",
    "test.coverage": "cross-env ENFORCE_COVERAGE_THRESHOLDS=true vitest run --coverage",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=verbose --reporter=junit --outputFile.junit=vitest-results.xml",
    "test:ci:memory": "node --max-old-space-size=8192 ./node_modules/.bin/vitest run --reporter=github-actions --reporter=blob --shard=$SHARD_INDEX/$SHARD_TOTAL",
    "test:run:components": "vitest run src/components",
    "test:run:hooks": "vitest run src/hooks",
    "test:run:layouts": "vitest run src/layouts",
    "test:run:services": "vitest run src/services",
    "test:run:utils": "vitest run src/utils",
    "test:run:views": "vitest run src/views",
    "cypress:install": "cypress install",
    "cypress:verify": "cypress verify",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --headless --browser chrome",
    "cypress:dev": "cypress run --config baseUrl=https://lcfs-dev.apps.silver.devops.gov.bc.ca/",
    "cypress:clear": "cypress cache clear",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bcgov/bc-sans": "^2.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/material-icons": "^5.2.5",
    "@fontsource/roboto": "^5.2.5",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
